# Vorlage — die ECHTE Datei liegt NICHT im Repo, sondern pro Host unter
#   ~/.config/anthropic/token.env        (chmod 600)
# Sie enthaelt das langlebige Abo-Token der Claude-Code-CLI, erzeugt mit
#   claude setup-token
# Dieselbe Datei wird von der interaktiven Shell (~/.bashrc) gesourct UND von
# run.sh (Cron erbt kein Shell-Environment, sourct daher explizit). So gibt es
# eine Token-Quelle pro Host fuer interaktiv + Automation.
# Ablauf ~1 Jahr -> dann `claude setup-token` neu und Wert hier ersetzen.
export CLAUDE_CODE_OAUTH_TOKEN='sk-ant-oat-...'
